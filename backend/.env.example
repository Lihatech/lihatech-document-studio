FIREBASE_PROJECT_ID=lihatech-document-studio
GOOGLE_APPLICATION_CREDENTIALS="C:\path\outside\repository\firebase-service-account.json"
# On Vercel, set FIREBASE_SERVICE_ACCOUNT_JSON instead of a local file path.
# Never use a VITE_ prefix for the service account or Supabase secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=https://your-project-ref.supabase.co
# Use a server-side secret or legacy service-role key. A publishable key cannot read private files.
SUPABASE_SECRET_KEY=sb_secret_replace_me
WEB_ORIGINS=http://localhost:3000
# Authorize the dedicated LihaTech organizer account once with Calendar events and free/busy scopes.
# Use its primary calendar so it remains the event and Meet organizer.
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
MOCK_INTERVIEWER_EMAIL=
MOCK_FIRST_HOUR=9
MOCK_LAST_HOUR=18
